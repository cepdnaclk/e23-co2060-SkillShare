{
    "info": {
        "name": "SkillShare API Tests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "01 Authentication",
            "item": [
                {
                    "name": "Register Mentor",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.collectionVariables.set(\"mentorEmail\", `mentor_${Date.now()}@test.com`);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.collectionVariables.set(\"mentorToken\", response.token);",
                                    "pm.collectionVariables.set(\"mentorId\", response.userId);",
                                    "pm.test(\"Has token and ID\", function () {",
                                    "    pm.expect(response.token).to.exist;",
                                    "    pm.expect(response.userId).to.exist;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fullName\": \"Test Mentor\",\n  \"email\": \"{{mentorEmail}}\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Register Learner",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.collectionVariables.set(\"learnerEmail\", `learner_${Date.now()}@test.com`);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.collectionVariables.set(\"learnerToken\", response.token);",
                                    "pm.collectionVariables.set(\"learnerId\", response.userId);",
                                    "pm.test(\"Initial credits are 100\", function () {",
                                    "    pm.expect(response.credits).to.eql(100);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fullName\": \"Test Learner\",\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "02 Mentor Setup",
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{mentorToken}}",
                        "type": "string"
                    }
                ]
            },
            "item": [
                {
                    "name": "Get Mentor Profile",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.test(\"ID matches\", function () {",
                                    "    pm.expect(response.id).to.eql(pm.collectionVariables.get(\"mentorId\"));",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/users/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "users",
                                "me"
                            ]
                        }
                    }
                },
                {
                    "name": "Add Skill to Mentor",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.collectionVariables.set(\"skillId\", response.skillId);",
                                    "pm.test(\"Skill ID exists\", function () {",
                                    "    pm.expect(response.skillId).to.exist;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"skillName\": \"Test Automation {{$randomTimestamp}}\",\n  \"skillType\": \"TEACH\",\n  \"skillCategory\": \"Technology\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/user-skills/add",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "user-skills",
                                "add"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Availability",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "let start = new Date();",
                                    "start.setMinutes(start.getMinutes() + 1);",
                                    "let end = new Date(start);",
                                    "end.setMinutes(end.getMinutes() + 2);",
                                    "let pad = n => n.toString().padStart(2, '0');",
                                    "let formatLocal = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;",
                                    "pm.collectionVariables.set(\"dynamicStartTime\", formatLocal(start));",
                                    "pm.collectionVariables.set(\"dynamicEndTime\", formatLocal(end));"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.collectionVariables.set(\"availabilityId\", response.id);",
                                    "pm.test(\"Availability created and not booked\", function () {",
                                    "    pm.expect(response.id).to.exist;",
                                    "    pm.expect(response.isBooked).to.be.false;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"startTime\": \"{{dynamicStartTime}}\",\n  \"endTime\": \"{{dynamicEndTime}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/availability/add",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "availability",
                                "add"
                            ]
                        }
                    }
                }
            ]
        },

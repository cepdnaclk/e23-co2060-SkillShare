                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.test(\"Session appears for mentor\", function () {",
                                    "    const s = response.find(s => s.id === pm.collectionVariables.get(\"sessionId\"));",
                                    "    pm.expect(s).to.exist;",
                                    "    pm.expect(s.status).to.eql(\"PENDING\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }

        {
            "name": "07 Early Completion (Blocked)",
            "item": [
                {
                    "name": "Attempt Early Completion",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{learnerToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "PATCH",
                        "url": {
                            "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sessions",
                                "{{sessionId}}",
                                "complete"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Cannot complete before end time (409 Conflict)\", function () {",
                                    "    pm.expect(pm.response.code).to.eql(409);",
                                    "});",
                                    "// Stop the automated Newman runner here so it doesn't run the manual suite",
                                    "pm.execution.setNextRequest(null);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },

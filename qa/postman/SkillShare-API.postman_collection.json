                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{mentorToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "PATCH",
                        "url": {
                            "raw": "{{baseUrl}}/sessions/{{sessionId}}/status?status=ACCEPTED",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sessions",
                                "{{sessionId}}",
                                "status"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "ACCEPTED"
                                }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.test(\"Session is ACCEPTED\", function () {",
                                    "    pm.expect(response.status).to.eql(\"ACCEPTED\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }

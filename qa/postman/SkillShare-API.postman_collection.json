        {
            "name": "04 Session Booking",
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{learnerToken}}",
                        "type": "string"
                    }
                ]
            },
            "item": [
                {
                    "name": "Book Session",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "pm.collectionVariables.set(\"sessionEndTime\", response.endTime);",
                                    "pm.collectionVariables.set(\"sessionId\", response.id);",
                                    "pm.test(\"Session created successfully\", function () {",
                                    "    pm.expect(response.id).to.exist;",
                                    "    pm.expect(response.status).to.eql(\"PENDING\");",
                                    "    pm.expect(response.mentorId).to.eql(pm.collectionVariables.get(\"mentorId\"));",
                                    "    pm.expect(response.learnerId).to.eql(pm.collectionVariables.get(\"learnerId\"));",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"skillId\": \"{{skillId}}\",\n  \"availabilityId\": \"{{availabilityId}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/sessions/book",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sessions",
                                "book"
                            ]
                        }
                    }
                },
                {
                    "name": "Verify Credit Deduction",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const response = pm.response.json();",
                                    "const expected = pm.collectionVariables.get(\"beforeBookingCredits\") - 10;",
                                    "pm.test(\"Credits deducted by 10\", function () {",
                                    "    pm.expect(response.credits).to.eql(expected);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/users/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "users",
                                "me"
                            ]
                        }
                    }
                }
            ]
        },
